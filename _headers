# Browser caching (Netlify). Pages, CSS, JS and admin content are always
# checked for updates; images and fonts are kept so pages open faster.

# Fonts and pre-sized image copies never change under the same name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/images/resp/*
  Cache-Control: public, max-age=31536000, immutable

# Brand artwork and icons: keep for 30 days, refresh quietly in the background.
/images/brand/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/images/icons/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Photos chosen in the admin panel: keep for a week (a re-uploaded photo with
# the same file name may take up to a week to refresh for returning visitors).
/images/uploads/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The admin panel program: the folder name carries its version, so it never changes.
/admin/decap-3.17.3/*
  Cache-Control: public, max-age=31536000, immutable
